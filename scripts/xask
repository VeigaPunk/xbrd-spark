#!/usr/bin/env bash
# This file is the L3 shim installed as xask-l3 (PATH xask is protocol xbreed).
# xask-l3 — thin sekhmet shim (flag-compat). Bare `sekhmet run` (Titanium default).
# `--direct` is accepted and ignored; clap has `--no-direct` only.
# Usage: xask-l3 [-d] [--model-id ID] [-e low] [--spark|--spk] [--gs] [--direct]
#             [--ro] [--timeout N] [--no-keep] [--root PATH] [--dry-run]
#             [codex] "<query>"
set -euo pipefail

_XASK_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
case ":$PATH:" in *":$_XASK_DIR:"*) ;; *) PATH="$_XASK_DIR:$PATH" ;; esac
export PATH

SEKHMET="${SEKHMET:-$(command -v sekhmet 2>/dev/null || echo sekhmet)}"

DEBUG=false
MODEL_ID=""
EFFORT=""
RO=false
TIMEOUT=""
NO_KEEP=false
ROOT=""
DRY_RUN=false

die() { echo "xask: $*" >&2; exit 1; }

require_flag_value() {
  local flag="$1"
  if [[ $# -lt 2 || -z "${2:-}" || "$2" == -* ]]; then
    die "flag '$flag' requires a value"
  fi
}

while [[ $# -gt 0 && "${1:-}" == -* ]]; do
  case "$1" in
    --debug | -d) DEBUG=true; shift ;;
    --model-id)
      require_flag_value "$@"
      MODEL_ID="$2"
      shift 2
      ;;
    --effort | -e)
      require_flag_value "$@"
      EFFORT="$2"
      shift 2
      ;;
    --spark | --spk) shift ;;
    --gs) shift ;;
    --direct) shift ;;
    --ro) RO=true; shift ;;
    --timeout)
      require_flag_value "$@"
      TIMEOUT="$2"
      shift 2
      ;;
    --no-keep) NO_KEEP=true; shift ;;
    --root)
      require_flag_value "$@"
      ROOT="$2"
      shift 2
      ;;
    --dry-run) DRY_RUN=true; shift ;;
    --review | -R) die "-R/--review not supported by this shim (use sekhmet)" ;;
    --full | -F) die "-F/--full not supported by this shim (use sekhmet)" ;;
    --gpt55) die "--gpt55 not supported by this shim (use sekhmet)" ;;
    -*) die "unknown flag '$1'" ;;
  esac
done

if [[ -n "$EFFORT" ]]; then
  case "$EFFORT" in
    low) ;;
    medium|high|xhigh) die "effort '$EFFORT' not supported (hardcoded low in sekhmet)" ;;
    *) die "invalid effort level '$EFFORT' (use low)" ;;
  esac
fi

MODEL="codex"
if [[ $# -gt 0 ]]; then
  case "$1" in
    codex) shift ;;
    gemma|g|gemini)
      die "model '$1' not supported by this shim (codex only)"
      ;;
  esac
fi

if [[ $# -eq 0 ]]; then
  die "usage: xask [-d] [--model-id ID] [-e low] [--spark|--spk] [--gs] [--direct] [--ro] [--timeout N] [--no-keep] [--root PATH] [--dry-run] [codex] \"<query>\""
fi

QUERY="$*"
MODEL_ID="${MODEL_ID:-gpt-5.6-luna}"

export XBRD_SPARK_MODEL="$MODEL_ID"
export XBRD_SPARK_SERVICE_TIER=fast
export XBRD_SPARK_FALLBACK_MODEL=none

# Bare `sekhmet run` already defaults Titanium. Clap exposes `--no-direct`
# only; passing `--direct` is `unexpected argument`.
argv=("$SEKHMET" run)
[[ "$RO" == true ]] && argv+=(--ro)
[[ -n "$TIMEOUT" ]] && argv+=(--timeout "$TIMEOUT")
[[ "$NO_KEEP" == true ]] && argv+=(--no-keep)
[[ -n "$ROOT" ]] && argv+=(--root "$ROOT")
[[ "$DRY_RUN" == true ]] && argv+=(--dry-run)
argv+=(--task "$QUERY")

if [[ "$DEBUG" == true ]]; then
  echo "=== XASK DEBUG ==="
  echo "MODEL: $MODEL"
  echo "MODEL_ID: $MODEL_ID"
  echo "EFFORT: ${EFFORT:-low}"
  echo "SEKHMET: $SEKHMET"
  echo "XBRD_SPARK_MODEL=$XBRD_SPARK_MODEL"
  echo "XBRD_SPARK_SERVICE_TIER=$XBRD_SPARK_SERVICE_TIER"
  echo "model_reasoning_effort=low"
  echo "service_tier=fast"
  echo "ARGV: ${argv[*]}"
  echo "constructed: $SEKHMET run -c model_reasoning_effort=low -c service_tier=fast -m ${MODEL_ID} --task ..."
  exit 0
fi

exec "${argv[@]}"
